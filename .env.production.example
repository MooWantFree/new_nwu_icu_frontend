# Production requests use same-origin relative /api URLs through Nginx.
# These values are only used if Vite's development server is run in production mode.
VITE_BACKEND_API_URL=https://nwu.icu

# Optional outside Docker. Local development reads both sibling Git repositories automatically.
# VITE_FRONTEND_COMMIT=<frontend-git-commit>
# VITE_BACKEND_COMMIT=<backend-git-commit>
